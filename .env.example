# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and update with your values
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=ir_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_use_strong_password_min_32_chars
POSTGRES_DB=ir_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Python Configuration
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# ML/NLP Model Cache Paths
# -----------------------------------------------------------------------------
# These paths are inside containers and should not be changed unless you know what you're doing
# SENTENCE_TRANSFORMERS_HOME: Where sentence-transformers models are cached/stored
# TORCH_HOME: PyTorch model cache (weights, configs)
# TRANSFORMERS_CACHE: HuggingFace transformers cache
SENTENCE_TRANSFORMERS_HOME=/app/data/models
TORCH_HOME=/app/data/cache/torch
TRANSFORMERS_CACHE=/app/data/cache/transformers

# -----------------------------------------------------------------------------
# Embedding Model Configuration
# -----------------------------------------------------------------------------
# Model will be downloaded from HuggingFace if not found locally
# Local model path (relative to /app): data/models/all-MiniLM-L6-v2
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# IR Datasets Configuration
# -----------------------------------------------------------------------------
# Path where ir_datasets library stores downloaded datasets
IR_DATASETS_HOME=/app/data/datasets/.ir_datasets

# -----------------------------------------------------------------------------
# Service Ports (Host Machine)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8000
PREPROCESSING_PORT=8001
INDEXING_PORT=8002
RETRIEVAL_PORT=8003
RANKING_PORT=8004
QUERY_REFINEMENT_PORT=8005
EVALUATION_PORT=8006
CLUSTERING_PORT=8007
RAG_PORT=8008
FRONTEND_PORT=8501

# -----------------------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------------------
# OpenAI API key for RAG (Retrieval-Augmented Generation) feature
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/app/logs

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# API Rate Limiting (requests per minute)
RATE_LIMIT=100

# Pagination defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Search defaults
DEFAULT_TOP_K=10
MAX_TOP_K=100

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_THIS_use_strong_password_min_32_chars
CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Development Settings (only for development mode)
# -----------------------------------------------------------------------------
# Enable hot reload for development
# RELOAD=true

# Enable debug mode
# DEBUG=true

# Expose detailed error messages
# SHOW_ERROR_DETAILS=true
