# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and update with your values
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=ir_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_use_strong_password_min_32_chars
POSTGRES_DB=ir_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Python Configuration
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# ML/NLP Model Cache Paths
# -----------------------------------------------------------------------------
# These paths are inside containers and should not be changed unless you know what you're doing
# SENTENCE_TRANSFORMERS_HOME: Where sentence-transformers models are cached/stored
# TORCH_HOME: PyTorch model cache (weights, configs)
# TRANSFORMERS_CACHE: HuggingFace transformers cache
SENTENCE_TRANSFORMERS_HOME=/app/data/models
TORCH_HOME=/app/data/cache/torch
TRANSFORMERS_CACHE=/app/data/cache/transformers

# -----------------------------------------------------------------------------
# Embedding Model Configuration
# -----------------------------------------------------------------------------
# Model will be downloaded from HuggingFace if not found locally
# Local model path (relative to /app): data/models/all-MiniLM-L6-v2
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# IR Datasets Configuration
# -----------------------------------------------------------------------------
# Path where ir_datasets library stores downloaded datasets
IR_DATASETS_HOME=/app/data/datasets/.ir_datasets

# -----------------------------------------------------------------------------
# Service Ports (Host Machine)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8000
PREPROCESSING_PORT=8001
INDEXING_PORT=8002
RETRIEVAL_PORT=8003
RANKING_PORT=8004
QUERY_REFINEMENT_PORT=8005
EVALUATION_PORT=8006
CLUSTERING_PORT=8007
RAG_PORT=8008
FRONTEND_PORT=8501

# -----------------------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------------------
# Remote generation (OpenAI-compatible endpoint)
RAG_REMOTE_BASE_URL=https://router.huggingface.co/v1
RAG_REMOTE_MODEL=meta-llama/Llama-3.1-8B-Instruct:cheapest
HUGGINGFACE_API_TOKEN=

# Local fallback model (CPU, offline)
RAG_LOCAL_ENABLED=true
RAG_LOCAL_MODEL=qwen2.5-0.5b-instruct
RAG_LOCAL_THREADS=2
RAG_LOCAL_DTYPE=float32

# Generation defaults
RAG_DEFAULT_MODE=auto
RAG_MODELS_DIR=/models/rag

# Diagnostics (development only)
RAG_ENABLE_DIAGNOSTICS=false

# -----------------------------------------------------------------------------
# Service Tuning
# -----------------------------------------------------------------------------
# Every value below has a default in code; set one only to change the default.

# Evaluation: queries evaluated in parallel (1 = serial, capped at 64)
EVALUATION_WORKERS=8

# Retrieval: uvicorn worker processes in docker-compose.yml. Each worker loads its
# own copy of the indices, so raise it only when memory allows. Dev --reload needs 1.
RETRIEVAL_UVICORN_WORKERS=1

# PostgreSQL connection pool shared by all services
DB_POOL_ENABLED=true
DB_POOL_MIN=1
DB_POOL_MAX=8

# API gateway: downstream timeouts (seconds) and retry policy
GATEWAY_PREPROCESSING_TIMEOUT=30
GATEWAY_RETRIEVAL_TIMEOUT=30
GATEWAY_HYBRID_TIMEOUT=60
GATEWAY_REFINEMENT_TIMEOUT=10
GATEWAY_RAG_TIMEOUT=300
GATEWAY_RAG_PROBE_TIMEOUT=10
GATEWAY_RAG_MODELS_TIMEOUT=30
GATEWAY_MAX_RETRIES=2
GATEWAY_RETRY_BACKOFF=0.2

# Gateway URLs default to the compose service names; override only outside compose
# GATEWAY_PREPROCESSING_URL=http://preprocessing:8001
# GATEWAY_RETRIEVAL_URL=http://retrieval:8003
# GATEWAY_QUERY_REFINEMENT_URL=http://query_refinement:8005
# GATEWAY_RAG_URL=http://rag:8008
# GATEWAY_METADATA_DIR=data/metadata

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
IR_LOG_DIR=/app/logs

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Rate limiting, enforced by the API gateway (per client address, per window)
# RATE_LIMIT is the number of requests allowed per RATE_LIMIT_WINDOW seconds; 0 disables it
RATE_LIMIT=300
RATE_LIMIT_WINDOW=60

# Pagination defaults

# Search defaults
DEFAULT_TOP_K=10
MAX_TOP_K=100

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_THIS_use_strong_password_min_32_chars
CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32

# CORS settings, applied by every service (comma-separated origins; empty = no CORS headers)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Allowed hosts (comma-separated)

# -----------------------------------------------------------------------------
# Development Settings (only for development mode)
# -----------------------------------------------------------------------------
# Enable hot reload for development
# RELOAD=true

# Enable debug mode
# DEBUG=true

# Expose detailed error messages
# SHOW_ERROR_DETAILS=true
