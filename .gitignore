# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Data - managed by Docker volumes and ir_datasets
# All downloaded datasets are stored in data/datasets/.ir_datasets/
data/datasets/.ir_datasets/*
!data/datasets/.ir_datasets/.gitkeep

# Keep placeholder files
data/datasets/*
!data/datasets/.gitkeep
!data/datasets/.ir_datasets/

data/indices/*
!data/indices/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep
data/models/*
!data/models/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Raw datasets (if any)
data/datasets/raw/*.jsonl
data/datasets/raw/*.json
!data/datasets/raw/.gitkeep

# Logs
logs/
*.log

# Environment variables
.env
.env.local
.env.*.local

# Config overrides
configs/config.local.yaml

# IDE
.vscode/
.idea/
.kiro/

# OS
.DS_Store
Thumbs.db

# Docker volumes and temporary files
docker-compose.override.yml

# Temporary files
*.tmp
*.bak
*.swp
*~

# Documentation
docs/
